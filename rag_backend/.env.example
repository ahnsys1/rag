# PostgreSQL 18 + pgvector
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:55433/rag

# Embeddings (fastembed / ONNX, runs locally without GPU)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
EMBEDDING_CACHE_DIR=./.model_cache

# Chunking
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# Answer generation (optional). LLM_PROVIDER=none returns retrieved passages only.
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Upload limits
MAX_UPLOAD_MB=50
CORS_ORIGINS=http://localhost:4200
